# ---------------------------------------------------------------------------
# VeriTrace environment configuration
# Copy this file to `.env` and fill in real values. Never commit the real
# `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Phase 2b: live web search (consent-gated reverse-image search) ---
# Preferred: a Google Cloud service-account JSON key (Application Default
# Credentials). The key file is git-ignored — never commit it. Run the CLI from
# the repo root so this relative path resolves, or set an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=veritrace-507220-bc47478b5c0a.json
# Alternative (API-key auth) for Google Cloud Vision, or use SerpAPI instead:
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_CLOUD_VISION_KEY_HERE
SERPAPI_API_KEY=YOUR_SERPAPI_KEY_HERE

# InsightFace model pack used for detection + 512-dim ArcFace embeddings.
#   buffalo_sc  -> compact pack (~15 MB): MobileFaceNet ArcFace (512-d) + RetinaFace (default)
#   buffalo_l   -> larger pack (~275 MB): ResNet-100 ArcFace (512-d) + multi-detector (best accuracy)
VERIFACE_MODEL_PACK=buffalo_sc

# Cosine-similarity threshold above which two face embeddings are considered
# the same identity (ArcFace typical range 0.45-0.6).
VERIFACE_SIMILARITY_THRESHOLD=0.6

# Default search domain allow-list for Phase 2 (comma separated hostnames).
VERIFACE_ALLOWED_DOMAINS=wikipedia.org,commons.wikimedia.org,unsplash.com,pexels.com

# --- Phase 3: Polygon Amoy on-chain evidence anchoring (git-ignored .env only) ---
# Copy `.env.example` -> `.env`. Never commit `.env`.
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_AMOY_CHAIN_ID=80002
# Owner key that deploys + anchors evidence. The Hardhat node (accounts[0]) key
# is 0xac0974bec39a17e36ba4a399ee235a3c22f0a6a7d4affa7f36c5edc61c06c059.
PRIVATE_KEY=your_amoy_private_key_here
# Set after `veritrace blockchain deploy --network amoy` succeeds.
VERIFACE_CONTRACT_ADDRESS=
