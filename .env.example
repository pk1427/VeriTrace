# ---------------------------------------------------------------------------
# VeriTrace environment configuration
# Copy this file to `.env` and fill in real values. Never commit the real
# `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

# Google Cloud Vision Web Detection API key (or SerpAPI key) — required from
# Phase 2 onward for the live web search step.
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_CLOUD_VISION_KEY_HERE
# Alternatively, if you prefer SerpAPI's google_reverse_image engine:
SERPAPI_API_KEY=YOUR_SERPAPI_KEY_HERE

# InsightFace model pack used for detection + 512-dim ArcFace embeddings.
#   buffalo_sc  -> compact pack (~15 MB): MobileFaceNet ArcFace (512-d) + RetinaFace (default)
#   buffalo_l   -> larger pack (~275 MB): ResNet-100 ArcFace (512-d) + multi-detector (best accuracy)
VERIFACE_MODEL_PACK=buffalo_sc

# Cosine-similarity threshold above which two face embeddings are considered
# the same identity (ArcFace typical range 0.45-0.6).
VERIFACE_SIMILARITY_THRESHOLD=0.6

# Default search domain allow-list for Phase 2 (comma separated hostnames).
VERIFACE_ALLOWED_DOMAINS=wikipedia.org,commons.wikimedia.org,unsplash.com,pexels.com
